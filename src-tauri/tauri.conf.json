{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lontar",
  "version": "0.1.0",
  "identifier": "com.nawa.lontar",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Lontar",
        "width": 1000,
        "height": 700,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "fileAssociations": [
      {
        "ext": [
          "epub"
        ],
        "name": "EPUB ebook",
        "description": "EPUB ebook",
        "role": "Viewer",
        "mimeType": "application/epub+zip",
        "contentTypes": [
          "org.idpf.epub-container"
        ]
      },
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF document",
        "description": "PDF document",
        "role": "Viewer",
        "mimeType": "application/pdf",
        "contentTypes": [
          "com.adobe.pdf"
        ],
        "rank": "Alternate"
      },
      {
        "ext": [
          "mobi",
          "azw",
          "azw3",
          "kf8"
        ],
        "name": "Kindle ebook",
        "description": "Kindle ebook",
        "role": "Viewer",
        "mimeType": "application/x-mobipocket-ebook"
      },
      {
        "ext": [
          "fb2"
        ],
        "name": "FictionBook ebook",
        "description": "FictionBook ebook",
        "role": "Viewer",
        "mimeType": "application/x-fictionbook+xml"
      },
      {
        "ext": [
          "cbz"
        ],
        "name": "Comic book archive",
        "description": "Comic book archive",
        "role": "Viewer",
        "mimeType": "application/vnd.comicbook+zip"
      }
    ]
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lontar",
  "version": "0.1.0",
  "identifier": "com.nawa.lontar",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Lontar",
        "width": 1000,
        "height": 700,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Read your ebooks and keep your place on every device",
    "longDescription": "A simple ebook reader for EPUB, PDF, Kindle, FB2 and comic book files. It remembers where you stopped in every book, and keeps your place, bookmarks and highlights in a small file next to each book, so a synced folder carries them to your other devices.",
    "macOS": {
      "signingIdentity": "-"
    },
    "fileAssociations": [
      {
        "ext": [
          "epub"
        ],
        "name": "EPUB ebook",
        "description": "EPUB ebook",
        "role": "Viewer",
        "mimeType": "application/epub+zip",
        "contentTypes": [
          "org.idpf.epub-container"
        ]
      },
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF document",
        "description": "PDF document",
        "role": "Viewer",
        "mimeType": "application/pdf",
        "contentTypes": [
          "com.adobe.pdf"
        ],
        "rank": "Alternate"
      },
      {
        "ext": [
          "mobi",
          "azw",
          "azw3",
          "kf8"
        ],
        "name": "Kindle ebook",
        "description": "Kindle ebook",
        "role": "Viewer",
        "mimeType": "application/x-mobipocket-ebook"
      },
      {
        "ext": [
          "fb2"
        ],
        "name": "FictionBook ebook",
        "description": "FictionBook ebook",
        "role": "Viewer",
        "mimeType": "application/x-fictionbook+xml"
      },
      {
        "ext": [
          "cbz"
        ],
        "name": "Comic book archive",
        "description": "Comic book archive",
        "role": "Viewer",
        "mimeType": "application/vnd.comicbook+zip"
      }
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/share/metainfo/io.github.aaripurna.Lontar.metainfo.xml": "../flatpak/io.github.aaripurna.Lontar.metainfo.xml"
        }
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ],
        "files": {
          "/usr/share/metainfo/io.github.aaripurna.Lontar.metainfo.xml": "../flatpak/io.github.aaripurna.Lontar.metainfo.xml"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGNjM2MEM3NERCMDQxQzgKUldUSVFiQk54MkJqLytvTlRiOFJ0ajVOY0o5Qk5FTG5ERzJ3cUhiREhlcWkySlprODN5ZnRwRmoK",
      "endpoints": [
        "https://github.com/aaripurna/lontar/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
